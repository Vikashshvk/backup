<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Chat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-8 offset-md-2"> 
                <h3>Create a New Listing</h3>
                <form action="/chat" method="POST"> 
                    <div class="mb-3">
                        <label for="from" class="form-label">From</label>
                        <input name="from" id="from" type="text" class="form-control" placeholder="Sender name" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="msg" class="form-label">Message</label>
                        <textarea name="msg" id="msg" class="form-control" placeholder="Write your message here..." required></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label for="to" class="form-label">To</label>
                        <input name="to" id="to" type="text" class="form-control" placeholder="Receiver name" required>
                    </div>
                    
                    <button class="btn btn-dark" type="submit">Submit</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>