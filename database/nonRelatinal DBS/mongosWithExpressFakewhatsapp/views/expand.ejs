<body>
     <h1>your Quots</h1>
    
        <div class="chat">
            <p class="box" id="one" ><b>From:</b> <%= newchat.from %></p>
            <div class="msg">
                <p class="box" id="two" ><b>Message:</b> <%= newchat.msg %></p>
            </div>
            <p class="box"id="three"><b>To:</b> <%= newchat.to %></p>

        <form action="/chat/<%=newchat.id%>/edit" method="get" > <button class="btn btn-dark">Edit this Quots</button> </form>
     </div> 
   
