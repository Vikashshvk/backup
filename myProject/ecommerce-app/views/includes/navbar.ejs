          <span class="fs-5">🛍️</span> 
          <span class="brand-highlight brand-text-mobile">ShopEase</span>
        </a>

        <!-- Home Button (Start me) -->
        <a class="nav-link nav-link-custom d-none d-lg-inline-flex" href="/listings">Home</a>

