                  <path d="M3.5 6.5A.5.5 0 0 1 4 7a4 4 0 0 0 8 0 .5.5 0 0 1 1 0 5 5 0 0 1-4.5 4.975V13.5h2a.5.5 0 0 1 0 1h-5a.5.5 0 0 1 0-1h2v-1.525A5 5 0 0 1 3 7a.5.5 0 0 1 .5-.5z"/>
                </svg>
            </button>
        </div>

