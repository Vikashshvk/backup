            </div>

            <!-- Quick Links -->
            <div class="col-md-4 text-center">
                <div class="d-flex justify-content-center gap-3 fs-6">
                    <a href="/listings" class="footer-link">Home</a>
                    <a href="/listings" class="footer-link">Products</a>
                    <a href="#" class="footer-link">Privacy Policy</a>
                </div>
            </div>

            <!-- Dark Mode Switcher -->
            <!-- <div class="col-md-4 text-center text-md-end">
                <div class="d-flex align-items-center justify-content-center justify-content-md-end gap-2">
                    <button id="darkModeToggle" class="btn theme-toggle-btn d-flex align-items-center gap-2">
