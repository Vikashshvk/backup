<% layout('layouts/boilerplate') %>

<style>
    .product-detail-card {
        border: none;
        border-radius: 16px;
        background: var(--card-bg, #ffffff);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    /* Fixed Height Image Slider */
    .product-slider-img {
        width: 100%;
        height: 320px;
        object-fit: cover;
        border-radius: 12px;
    }

    .carousel-inner {
        border-radius: 12px;
    }

    .price-tag-lg {
        font-size: 1.5rem;
        font-weight: 800;
        color: #059669;
    }

    .btn-cart, .btn-buy {
        font-weight: 700;
        border-radius: 8px;
        padding: 8px 16px;
    }

    .btn-cart {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
    }

    .btn-buy {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
    }

    .review-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
    }
</style>

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card product-detail-card p-3">
                <div class="row g-3 align-items-center">
                    
                    <!-- 5-6 PHOTOS SLIDER (BOOTSTRAP CAROUSEL) -->
                    <div class="col-md-6">
                        <div id="productCarousel" class="carousel slide shadow-sm rounded-3" data-bs-ride="carousel">
                            
                            <!-- Carousel Indicators (Dots) -->
                            <% if(listing.images && listing.images.length > 1) { %>
                                <div class="carousel-indicators">
                                    <% listing.images.forEach((img, idx) => { %>
                                        <button type="button" data-bs-target="#productCarousel" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>"></button>
                                    <% }) %>
                                </div>
                            <% } %>

                            <!-- Carousel Images -->
                            <div class="carousel-inner">
                                <% if(listing.images && listing.images.length > 0) { %>
                                    <% listing.images.forEach((img, idx) => { %>
                                        <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                                            <img src="<%= img %>" class="d-block product-slider-img" alt="<%= listing.title %>">
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="carousel-item active">
                                        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=800" class="d-block product-slider-img" alt="Product Image">
                                    </div>
                                <% } %>
                            </div>

                            <!-- Controls (Next/Prev Buttons) -->
                            <% if(listing.images && listing.images.length > 1) { %>
                                <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                </button>
                            <% } %>

                        </div>
                    </div>

                    <!-- Compact Info & Actions -->
                    <div class="col-md-6">
                        <span class="badge bg-secondary mb-1 px-2 py-1 fs-7">
                            Owner: <%= listing.owner ? listing.owner.username : 'Admin' %>
                        </span>
                        
                        <h4 class="fw-bold mb-2"><%= listing.title %></h4>
                        <p class="text-muted small mb-2"><%= listing.description %></p>

                        <div class="mb-3">
                            <span class="price-tag-lg">₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-cart btn-sm flex-fill" onclick="alert('Added to Cart!')">🛒 Add to Cart</button>
                            <button class="btn btn-buy btn-sm flex-fill" onclick="alert('Redirecting...')">⚡ Buy Now</button>
                        </div>
                    </div>

                </div>
            </div>

            <!-- REVIEWS SECTION -->
            <div class="mt-4">
                <h5 class="fw-bold mb-3">Customer Reviews</h5>

                <!-- Add Review Form -->
                <% if(currUser) { %>
                    <div class="card product-detail-card p-3 mb-3">
                        <h6 class="fw-bold mb-2">Leave a Review</h6>
                        <form action="/listings/<%= listing._id %>/reviews" method="POST">
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Rating</label>
                                <select name="review[rating]" class="form-select form-select-sm" required>
                                    <option value="5">5 ⭐ - Excellent</option>
                                    <option value="4">4 ⭐ - Very Good</option>
                                    <option value="3">3 ⭐ - Good</option>
                                    <option value="2">2 ⭐ - Fair</option>
                                    <option value="1">1 ⭐ - Poor</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Comment</label>
                                <textarea name="review[comment]" class="form-control form-control-sm" rows="2" placeholder="Write your review..." required></textarea>
                            </div>
                            <button class="btn btn-primary btn-sm fw-bold">Submit Review</button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="alert alert-warning py-2 small mb-3">
                        Please <a href="/login" class="fw-bold text-dark">Login</a> to write a review.
                    </div>
                <% } %>

                <!-- All Reviews List -->
                <div class="row g-2">
                    <% if(listing.reviews && listing.reviews.length > 0) { %>
                        <% for(let review of listing.reviews) { %>
                            <div class="col-12">
                                <div class="review-card p-2 px-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <strong class="small">@<%= review.author ? review.author.username : 'User' %></strong>
                                            <span class="badge bg-warning text-dark fs-7"><%= review.rating %> ★</span>
                                        </div>
                                        <p class="mb-0 small text-muted"><%= review.comment %></p>
                                    </div>

                                    <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
                                        <div>
                                            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                                <button class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;">Delete</button>
                                            </form>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    <% } else { %>
                        <p class="text-muted small">No reviews yet. Be the first to review!</p>
                    <% } %>
                </div>
            </div>

            <div class="mt-3 text-center">
                <a href="/listings" class="text-decoration-none small text-secondary">← Back to All Products</a>
            </div>

        </div>
    </div>
</div>