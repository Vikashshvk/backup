<% layout('layouts/boilerplate') %>

<style>
    /* Premium Page Background */
    body {
        background: radial-gradient(circle at 10% 20%, rgb(240, 244, 248) 0%, rgb(226, 232, 240) 90.1%);
        min-height: 100vh;
    }

    /* Section Heading Styling */
    .page-title {
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #0f172a;
    }

    /* Card Styling & Hover Animation */
    .product-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 35px rgba(0, 0, 0, 0.12) !important;
        background: #ffffff;
    }

    /* Image Zoom Effect */
    .img-wrapper {
        position: relative;
        overflow: hidden;
        height: 220px;
    }

    .product-img {
        height: 100%;
        width: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.08);
    }

    /* Price Badge */
    .price-tag {
        font-size: 1.25rem;
        font-weight: 700;
        color: #059669;
    }

    /* Action Button */
    .btn-view {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.3s ease;
        border: none;
    }

    .btn-view:hover {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    /* Description Clamp (Truncate extra text) */
    .clamp-text {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title mb-0">Explore Products</h2>
            <small class="text-muted">Discover top deals and latest additions</small>
        </div>
        <span class="badge bg-dark rounded-pill fs-6 px-3 py-2 shadow-sm"><%= allListings.length %> Items</span>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% for(let listing of allListings) { %>
            <div class="col">
                <div class="card product-card h-100">
                    
                    <!-- Product Image with Zoom Effect -->
                    <div class="img-wrapper">
                        <img src="<%= listing.images && listing.images.length > 0 ? listing.images[0] : listing.image %>" class="product-img" alt="<%= listing.title %>">
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column p-3">
                        <h5 class="card-title fw-bold text-dark text-truncate mb-1"><%= listing.title %></h5>
                        <p class="card-text text-muted clamp-text small flex-grow-1"><%= listing.description %></p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <div>
                                <span class="text-muted small d-block">Price</span>
                                <span class="price-tag">₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %></span>
                            </div>
                            <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-view px-3 py-2">View Details</a>
                        </div>
                    </div>

                </div>
            </div>
        <% } %>
    </div>
</div>