<% layout('layouts/boilerplate') %>

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3">List New Product for Sale</h2>
        <form action="/listings" method="POST">
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input type="text" name="listing[title]" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="listing[description]" class="form-control" rows="3" required></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Image URL</label>
                <input type="text" name="listing[image]" class="form-control" placeholder="https://..." />
            </div>
            <div class="mb-3">
                <label class="form-label">Price (in ₹)</label>
                <input type="number" name="listing[price]" class="form-control" required />
            </div>
            <button class="btn btn-primary w-100">Add Listing</button>
        </form>
    </div>
</div>